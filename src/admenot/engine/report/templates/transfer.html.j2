<!doctype html>
<html lang="{{ p.lang }}">
<head>
<meta charset="utf-8">
<title>{{ t.title }} {{ p.number }}</title>
<style>
{% include "transfer.css" %}
</style>
</head>
<body>
{% macro icon(key) %}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{%- if key == "contacts" %}<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
{%- elif key == "sms" %}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
{%- elif key == "calls" %}<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>
{%- elif key == "photos" %}<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="m21 16-5-5-9 9"/>
{%- elif key == "downloads" %}<path d="M6 3h8l5 5v13H6z"/><path d="M14 3v5h5M9 14h6M9 17h6"/>
{%- elif key == "whatsapp" %}<path d="M21 12a8.5 8.5 0 0 1-12.6 7.4L3 21l1.7-5.2A8.5 8.5 0 1 1 21 12z"/>
{%- else %}<path d="M3 6a2 2 0 0 1 2-2h4l2 3h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
{%- endif %}</svg>{% endmacro %}
{% macro device(d, label) %}<div class="dev"><span class="lbl">{{ label }}</span>
{%- if d %}<b>{{ d.name }}</b>
<small>{% if d.model %}{{ d.model }}{% endif %}{% if d.model and d.android %} · {% endif %}{% if d.android %}Android {{ d.android }}{% endif %}</small>
<small class="mono">{% if d.imei %}IMEI {{ d.imei }}{% elif d.serial %}{{ t.serial }} {{ d.serial }}{% endif %}</small>
{%- else %}<b class="none">—</b><small>{{ t.no_target }}</small>{% endif %}</div>{% endmacro %}
<header class="head">
  <div class="svc">
    {% if logo %}<img class="logo" src="{{ logo }}" alt="">{% endif %}
    <div>
      {% if service.name %}<b>{{ service.name }}</b>{% endif %}
      {% set line = [service.address, service.phone, service.email, service.website] | select | join(" · ") %}
      {% if line %}<span>{{ line }}</span>{% endif %}
      {% if service.nip %}<span>NIP {{ service.nip }}</span>{% endif %}
    </div>
  </div>
  <div class="ttl"><b>{{ t.title }}</b><span class="mono">{{ p.number }}</span></div>
</header>

<section class="route">
  {{ device(p.source, t.from_phone) }}
  <div class="arr"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg></div>
  {{ device(p.target, t.to_phone) }}
</section>
<p class="meta"><span>{{ t.client }} <b>{{ p.client or "—" }}</b></span><span>{{ t.received }} <b>{{ received }}</b></span><span>{{ t.issued }} <b>{{ issued }}</b></span></p>
<div class="status {{ p.tone }}"><span class="dot">{% if p.tone == "ok" %}<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>{% else %}!{% endif %}</span>{{ p.headline }}</div>

{% if tiles %}
<h2>{{ t.data_title }}</h2>
<div class="tiles">
{% for x in tiles %}
  <div class="tile {{ x.tone }}">
    <div class="top"><span class="ic">{{ icon(x.key) }}</span>{{ x.name }}</div>
    <div class="big">{{ x.big }}{% if x.rest %} <span>{{ x.rest }}</span>{% endif %}</div>
    <div class="st {{ x.tone }}">{{ x.state }}</div>
  </div>
{% endfor %}
</div>
{% endif %}

{% if p.apps_total %}
<h2>{{ t.apps_title }}</h2>
<div class="appsA">
  <div class="row"><span class="cnt">{{ p.apps_installed }} {{ t.of }} {{ p.apps_total }}</span><div class="bar"><i style="width: {{ percent }}%"></i></div><span class="inst">{{ t.installed_label }}</span></div>
  {% if names %}<p class="names">{{ names }}.</p>{% endif %}
  {% if problems %}
  <ul class="prob">
  {% for name, reason in problems %}
    <li><b>{{ name }}</b><span class="r">{{ reason }}</span></li>
  {% endfor %}
  {% if problems_more %}<li><span class="s">{{ t.problems_more.format(n=problems_more) }}</span></li>{% endif %}
  </ul>
  {% endif %}
  {% if malicious %}<p class="names">{{ malicious }}</p>{% endif %}
</div>
{% endif %}

<div class="two">
  <div class="box"><span class="lbl">{{ t.cannot_title }}</span><ul>{% for x in t.cannot %}<li>{{ x }}</li>{% endfor %}</ul></div>
  <div class="box"><span class="lbl">{{ t.info_title }}</span><ul>{% for x in info %}<li>{{ x }}</li>{% endfor %}</ul></div>
</div>

{% if copy_line %}<p class="priv">{{ copy_line }}</p>{% endif %}
<div class="sign"><div><b class="tech">{{ service.technician or "" }}</b><span></span>{{ t.signature_service }}</div><div><b class="tech"></b><span></span>{{ t.signature_client }}</div></div>
{% if footer %}<p class="svc-footer">{{ footer }}</p>{% endif %}
<p class="foot">{{ generated }}</p>
</body>
</html>
