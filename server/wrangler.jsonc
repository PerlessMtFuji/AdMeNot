{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "admenot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Kod Workera tylko dla API — strona nie zużywa limitu wywołań (spec §2.1).
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "admenot",
      "database_id": "f360424a-d6fa-4483-b1e2-6441be5e6efc",
      "migrations_dir": "migrations"
    }
  ],
  // Limiter raportów: klucz trzymany tylko w pamięci limitera (spec backendu §2.2, raportów §6.2).
  "ratelimits": [
    { "name": "REPORTS_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Statystyki: limiter przed czytaniem treści i przed D1 — program wysyła najwyżej kilka
    // zapytań na 10 minut, więc 60/min na adres zatrzymuje tylko zalew (audyt 2026-10-11, SEC-03).
    { "name": "TELEMETRY_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // Dobowy limit na adres: liczniki pod kluczem HMAC(sekret QUOTA_KEY, dzień, adres), kasowane o północy UTC.
  "durable_objects": { "bindings": [{ "name": "QUOTA", "class_name": "Quota" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Quota"] }],
  // Codzienne usuwanie raportów starszych niż 90 dni (spec raportów §6.3).
  "triggers": { "crons": ["17 3 * * *"] },
  // Bez Workers Logs: nie zapisujemy adresów IP (spec §2.2).
  "observability": { "enabled": false }
}
